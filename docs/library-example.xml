<?xml version="1.0" encoding="utf-8"?>
<!--
  TubeWorks tube library, release 1. Copy to %APPDATA%\TubeWorks\library.xml and edit.
  ALL VALUES ARE IN METRES. The numbers below are EXAMPLES that show the format only.
  They are not recommendations. Replace them with your own material, machine and tooling data.
  Leave out an optional element (MinBendRadius, MinStraightBetweenBends, MinClampLength) when you do not know it:
  TubeWorks then does not run that check.
-->
<TubeLibrary xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
  <Presets>
    <TubePreset>
      <Name>EXAMPLE 25.4 x 1.65 304</Name>
      <Material>AISI 304</Material>
      <OuterDiameter>0.0254</OuterDiameter>
      <WallThickness>0.00165</WallThickness>
      <StockLengths>
        <double>6</double>
      </StockLengths>
      <BendRadii>
        <double>0.0381</double>
        <double>0.0508</double>
      </BendRadii>
      <MinBendRadius>0.0381</MinBendRadius>
      <MinStraightBetweenBends>0.03</MinStraightBetweenBends>
      <MinClampLength>0.05</MinClampLength>
      <MaxBendAngleDeg>180</MaxBendAngleDeg>
      <Machine>EXAMPLE machine</Machine>
      <Tooling>EXAMPLE die set</Tooling>
    </TubePreset>
  </Presets>
</TubeLibrary>
